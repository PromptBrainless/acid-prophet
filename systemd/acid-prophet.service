[Unit]
Description=Acid Prophet Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=djstream
Group=djstream
WorkingDirectory=/srv/dj-stream
EnvironmentFile=/srv/dj-stream/.env
ExecStart=/usr/bin/python3 /srv/dj-stream/app/bot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/dj-stream/data /srv/dj-stream/logs /srv/dj-stream/reports /srv/dj-stream/overlays

[Install]
WantedBy=multi-user.target
